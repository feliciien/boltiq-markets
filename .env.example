# BoltIQ Markets (boltiqmarkets.com) — Environment Configuration Template
# WorkFusionApp, Inc.
# Copy this file to .env or .env.local for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.

# Public Application URLs
VITE_APP_URL="https://boltiqmarkets.com"
VITE_CANONICAL_DOMAIN="boltiqmarkets.com"
VITE_SECONDARY_DOMAIN="www.boltiqmarkets.com"

# Server-Side Only Credentials (NEVER prefix with VITE_ or expose to client bundle)
# Configure these in Vercel Environment Variables:
GEMINI_API_KEY=""

# Deployment Environment
NODE_ENV="production"
